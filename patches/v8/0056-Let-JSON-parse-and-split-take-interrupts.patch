diff --git a/src/runtime/runtime-regexp.cc b/src/runtime/runtime-regexp.cc
index ec17453..edf9c70 100644
--- a/src/runtime/runtime-regexp.cc
+++ b/src/runtime/runtime-regexp.cc
@@ -884,13 +884,23 @@ RUNTIME_FUNCTION(Runtime_StringSplit) {
 
   std::vector<int>* indices = GetRewoundRegexpIndicesList(isolate);
 
-  FindStringIndicesDispatch(isolate, *subject, *pattern, indices, limit,
-                            first_index);
+  // More parts than the largest array cannot be stored (V8 would end the
+  // process), so the split throws a RangeError instead; finding one index
+  // past that maximum is enough to know.
+  constexpr uint32_t kMaxParts = FixedArray::kMaxLength;
+  FindStringIndicesDispatch(isolate, *subject, *pattern, indices,
+                            std::min(limit, kMaxParts + 1), first_index);
 
   if (static_cast<uint32_t>(indices->size()) < limit) {
     indices->push_back(subject_length);
   }
 
+  if (V8_UNLIKELY(indices->size() > kMaxParts)) {
+    TruncateRegexpIndicesList(isolate);
+    THROW_NEW_ERROR_RETURN_FAILURE(
+        isolate, NewRangeError(MessageTemplate::kInvalidArrayLength));
+  }
+
   // The list indices now contains the end of each part to create.
 
   // Create JSArray of substrings separated by separator.
@@ -910,6 +920,16 @@ RUNTIME_FUNCTION(Runtime_StringSplit) {
   } else {
     int part_start = 0;
     FOR_WITH_HANDLE_SCOPE(isolate, int i = 0, i, i < part_count, i++) {
+      // Every part may allocate: handle interrupts now and then, so that a
+      // termination requested meanwhile (a CPU or memory limit) takes effect.
+      if (V8_UNLIKELY((i & 0x3FF) == 0x3FF)) {
+        StackLimitCheck interrupt_check(isolate);
+        if (V8_UNLIKELY(interrupt_check.InterruptRequested()) &&
+            IsExceptionHole(isolate->stack_guard()->HandleInterrupts())) {
+          TruncateRegexpIndicesList(isolate);
+          return ReadOnlyRoots(isolate).exception();
+        }
+      }
       int part_end = indices->at(i);
       DirectHandle<String> substring =
           isolate->factory()->NewProperSubString(subject, part_start, part_end);
