    name = "coworkerd-sandbox",
    srcs = ["coworkerd-sandbox.c++"],
    hdrs = ["coworkerd-sandbox.h"],
    visibility = [
        "//src/workerd/server:__subpackages__",
        "//src/workerd/threaded:__pkg__",
    ],
    deps = [
        "//src/workerd/jsg",
        "@capnp-cpp//src/kj",
    ],
)

# The V8 sandbox of --config=coworkerd-sandbox: its layout, V8's secure mode for the process and for
