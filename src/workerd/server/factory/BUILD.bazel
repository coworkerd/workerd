    hdrs = ["coworkerd-steady.h"],
    deps = ["@capnp-cpp//src/kj"],
    visibility = ["//src/workerd/threaded:__pkg__"],
)

# The V8 sandbox of --config=coworkerd-sandbox: the startup and per-isolate checks, and isolate
# groups that can fail. Used by the factory and the threaded server.
